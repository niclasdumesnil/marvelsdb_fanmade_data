{
  "_comment": "Regles de formatage des textes de cartes Marvel Champions. REFERENCE UNIQUE : ce fichier et `keywords_dict.json` a cote de lui. Ils vivent ici parce que leurs consommateurs lisent deja ce repertoire sur disque — MC4DB Dev le lit a l'execution, l'editeur MC4DB en prend une copie a la compilation (`scripts/synchroniser-formatage.mjs`). Toute autre copie est un doublon a supprimer : c'est d'avoir laisse deux exemplaires diverger que sont nees des lignes anglaises non traduites dans des champs francais.",
  "rules": [
    {
      "id": "ability-name-emdash",
      "description": "Ability title before an em-dash (—) must be in italic <i> tags",
      "pattern": "(?:<b>)?([A-Z][a-zA-Z0-9'\\s]+)(?:<\\/b>)?\\s*—",
      "replacement": "<i>$1</i> —",
      "severity": "error"
    },
    {
      "id": "colon-outside-bold",
      "description": "The colon (:) must be placed outside the bold <b> tag",
      "pattern": "<b>([^<]+):<\\/b>",
      "replacement": "<b>$1</b>:",
      "severity": "error"
    },
    {
      "id": "colon-trailing-space-en",
      "description": "Mandatory space after a colon in English text",
      "pattern": "(?<!https?)(?<!\\d):([a-zA-Z0-9\\[])",
      "replacement": ": $1",
      "severity": "error"
    },
    {
      "id": "colon-spacing-fr",
      "description": "Non-breaking space before colon and space after colon in French text",
      "pattern": "(?<!https?)(?<!\\d)(?:[ \\t\\u00A0]|&nbsp;)*:[ \\t]*([a-zA-Z0-9\\[À-ÖØ-öø-ÿ])",
      "replacement": " : $1",
      "severity": "error"
    },
    {
      "id": "boost-line-format-en",
      "description": "Boost line format in English: <hr>[star] <b>Boost</b>: ",
      "pattern": "^(?:\\*\\s*)?(?:\\[star\\]|\\*)*\\s*(?:<b>)?Boost(?:<\\/b>)?\\s*:\\s*",
      "replacement": "<hr>[star] <b>Boost</b>: ",
      "severity": "warning"
    },
    {
      "id": "boost-line-format-fr",
      "description": "Boost line format in French: <hr>[star] <b>Boost</b> : ",
      "pattern": "^(?:\\*\\s*)?(?:\\[star\\]|\\*)*\\s*(?:<b>)?Boost(?:<\\/b>)?\\s*\\u00A0?:\\s*",
      "replacement": "<hr>[star] <b>Boost</b> : ",
      "severity": "warning"
    }
  ],
